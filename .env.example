# Application
APP_NAME=ClaimBridge
APP_VERSION=0.1.0
DEBUG=False
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://claimbridge:password@localhost:5432/claimbridge
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20

# VectorDB (Weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-api-key

# LLM (OpenAI)
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# RAG Configuration
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Quality Rubric
QUALITY_MIN_SCORE=3.5

# Multi-Tenant
TENANT_ISOLATION_ENABLED=True
SUPPORTED_TENANTS=pacific-hmo,coastal-ppo,summit-employer

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Audit
AUDIT_LOGGING_ENABLED=True
